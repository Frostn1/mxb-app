# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tauri updater signing keys — never commit
*.key
*.key.pub

# Shop catalog API credential, baked into the binary at build time by src-tauri/build.rs.
# Covered by `*.local` above; spelled out so it's findable. Copy .env.local.example.
/.env.local

# Vite transient config-reload artifacts
vite.config.ts.timestamp-*.mjs

# Local agent workspace (todo/lessons/plans) — never commit
tasks/

# bun is the canonical package manager: bun.lock is committed and every CI job
# installs with `bun install --frozen-lockfile` on oven-sh/setup-bun. There is no
# package-lock.json any more, so nothing should reintroduce one.
package-lock.json

# Local-only security/IP architecture docs — never publish to the public repo
docs/secure-content/

# Private archive/decryption implementations. Release CI syncs these from the private repo after
# checkout; they must never become Git objects in this public repository.
crates/core/src/mxbsecure.rs
crates/core/src/sidecar.rs

# CI-only checkout of the private sidecar module (see .github/workflows/release.yml)
/.sidecar-src/

# The compiled UI-driving harness; build it with swiftc from the .swift beside it.
docs/guides/tools/uidrive

# Cargo build output — the workspace target now lives at the repo root.
/target/
/target-win/

# Process output and local logs
*.out

# Local AI agent workspaces & worktrees
.worktrees/
.claude/
.codex/

# Local agent instructions & RE guidelines (keep private / untracked)
AGENTS.md
CLAUDE.md

# Local livery development tooling and dump harness
tools/
apps/manager/src-tauri/src/liverydump.rs
