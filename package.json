{
  "name": "frost-monorepo",
  "private": true,
  "version": "0.15.1",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/manager",
    "apps/studio",
    "apps/coach"
  ],
  "scripts": {
    "dev": "cd apps/manager && bun run dev",
    "start-dev": "cd apps/manager && bun run start-dev",
    "build-prod": "cd apps/manager && bun run build-prod",
    "tauri": "cd apps/manager && bun run tauri",
    "build": "bun run --filter '*' build",
    "check:secure-boundary": "bun scripts/check-secure-boundary.mjs",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "dev:studio": "cd apps/studio && bun run dev",
    "tauri:studio": "cd apps/studio && bun run tauri",
    "dev:coach": "cd apps/coach && bun run dev",
    "tauri:coach": "cd apps/coach && bun run tauri"
  },
  "overrides": {
    "postcss": "^8.5.25"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
