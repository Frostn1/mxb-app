{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frost Converter",
  "mainBinaryName": "frost-converter",
  "version": "0.1.3",
  "identifier": "com.frost.frostconverter",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1460",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Frostn1/frost-converter/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0MzIzNzI1NzM2QUU4NApSV1NFcmpaWGNpTkRBdDQwOUlnVW54VmVJTHdWSGc4bTVqQkRCUjlkdjVxUGFBUnpUWUU5ay96TQo="
    }
  },
  "app": {
    "windows": [
      {
        "title": "Frost Converter",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#121417"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "createUpdaterArtifacts": true,
    "licenseFile": "../../../LICENSE",
    "publisher": "Frost",
    "copyright": "Copyright © 2026 Frost",
    "homepage": "https://github.com/Frostn1/frost-converter",
    "shortDescription": "FBX to EDF for MX Bikes",
    "longDescription": "Converts FBX models to the EDF files MX Bikes loads.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
