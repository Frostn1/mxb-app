{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frost Studio",
  "mainBinaryName": "Frost Studio",
  "version": "0.2.0",
  "identifier": "com.frost.froststudio",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "beforeBundleCommand": "bash ../../scripts/pack-binary.sh",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Frostn1/frost-studio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5QTRCRkUxODc2NjUzMkIKUldRclUyYUg0YitrV1dUQkhWTGdCYlRjTFJrK2xlMHpsRE5tSjFMdFhDTmtkazBneVlPajNMazUK"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Frost's Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "backgroundColor": "#121417"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "category": "Game",
    "createUpdaterArtifacts": true,
    "licenseFile": "../../../LICENSE",
    "publisher": "Frost",
    "copyright": "Copyright © 2026 Frost",
    "homepage": "https://github.com/Frostn1/mxb-app",
    "shortDescription": "MX Bikes content studio",
    "longDescription": "Frost's Studio is where MX Bikes content is made — paints, tracks and rider kit.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
