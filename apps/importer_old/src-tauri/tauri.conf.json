{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frost Importer",
  "mainBinaryName": "frost-importer",
  "version": "0.1.2",
  "identifier": "com.frost.frostimporter",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1470",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Frost Importer",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#121417"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "resources": { "WebView2Loader.dll": "WebView2Loader.dll" },
    "publisher": "Frost",
    "copyright": "Copyright © 2026 Frost",
    "shortDescription": "MX Bikes models to Blender",
    "longDescription": "Opens MX Bikes models as .blend files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
