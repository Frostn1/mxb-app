{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MXB Servers",
  "mainBinaryName": "MXB Servers",
  "version": "0.1.0",
  "identifier": "com.frost.mxbservers",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1450",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MXB Servers",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Frost",
    "copyright": "Copyright © 2026 Frost",
    "shortDescription": "mxbserver fleet manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
