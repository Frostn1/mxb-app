{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MXB Cinema",
  "mainBinaryName": "MXB Cinema",
  "version": "0.1.0",
  "identifier": "com.frost.mxbcinema",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1470",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "licenseFile": "legal/EULA.txt",
    "publisher": "Frost",
    "copyright": "Copyright © 2026 Frost",
    "shortDescription": "MX Bikes rides into Blender shots",
    "longDescription": "MXB Cinema turns a ride you recorded in MX Bikes into a ready-to-open Blender scene: track, bike, rider, cameras and light.",
    "resources": {
      "blender/": "blender/",
      "legal/": "legal/",
      "resources/": "resources/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
