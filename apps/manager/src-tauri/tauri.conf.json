{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MXB App",
  "mainBinaryName": "MXB App",
  "version": "0.20.10",
  "identifier": "com.frost.mxbikes",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MXB App",
        "width": 1400,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "decorations": false,
        "create": false,
        "visible": false,
        "backgroundColor": "#121417"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' blob:; script-src-elem 'self' 'unsafe-inline' blob:; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: imgcache: http://imgcache.localhost; media-src 'self' data: blob: https:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mxb"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Frostn1/mxb-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDRjEwQjlFQjhBQ0REOTQKUldTVTNheTRuZ3Z4ZklVZmltc3lLdWJtMUoxOUlycGhmbUJOL0JGMW5tMjlwblZtZzNaa2JGdVIK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "category": "Game",
    "createUpdaterArtifacts": true,
    "licenseFile": "../../../LICENSE",
    "publisher": "Frost",
    "copyright": "Copyright © 2026 Frost",
    "homepage": "https://github.com/Frostn1/mxb-app",
    "shortDescription": "The unofficial MX Bikes app",
    "longDescription": "MXB App is the unofficial MX Bikes app. Browse mxb-mods.com, install tracks, bikes and paints with one click, find servers, and let FrostMod reload the game for you. Plugins and Extensions are coming soon. Not affiliated with PiBoSo / MX Bikes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"]
      }
    }
  }
}
