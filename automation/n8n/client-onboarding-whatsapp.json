{
  "name": "קליטת לקוח — הודעת אונבורדינג בוואטסאפ",
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "nodes": [
    {
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Monday Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-720, 300],
      "webhookId": "mxb-client-onboarding",
      "parameters": {
        "httpMethod": "POST",
        "path": "mxb-client-onboarding",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Is Handshake?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-500, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "operator": { "type": "object", "operation": "notEmpty", "singleValue": true },
              "leftValue": "={{ $json.body.challenge }}",
              "rightValue": ""
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Echo Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-280, 160],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ challenge: $json.body.challenge }) }}",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Ack 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-280, 440],
      "parameters": {
        "respondWith": "text",
        "responseBody": "ok",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Fetch Client From Monday",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-60, 440],
      "parameters": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "API-Version", "value": "2024-10" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: 'query($id:[ID!]){ items(ids:$id){ id name column_values(ids:[\"phone_mkwpb7vp\",\"email_mkwp9hz4\",\"color_mkxfbf3j\",\"ONBOARDING_SENT_COLUMN_ID\"]){ id text } } }', variables: { id: [String($json.body.event.pulseId)] } }) }}",
        "options": { "response": { "response": { "neverError": false } } }
      },
      "notes": "Replace ONBOARDING_SENT_COLUMN_ID with the guard column id once created on board 5053409738."
    },
    {
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Normalize + Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [160, 440],
      "parameters": {
        "jsCode": "// Flattens the monday item, normalizes the phone to Green API chatId format,\n// and decides whether this client has already been onboarded.\nconst GUARD_COLUMN_ID = 'ONBOARDING_SENT_COLUMN_ID';\n\nconst item = $input.first().json?.data?.items?.[0];\nif (!item) {\n  throw new Error('monday returned no item for this webhook — check the pulseId mapping');\n}\n\nconst cols = Object.fromEntries((item.column_values || []).map(c => [c.id, c.text || '']));\n\nconst raw = (cols['phone_mkwpb7vp'] || '').replace(/\\D/g, '');\nlet msisdn;\nif (raw.startsWith('972')) msisdn = raw;\nelse if (raw.startsWith('0')) msisdn = '972' + raw.slice(1);\nelse if (raw.length === 9) msisdn = '972' + raw;\nelse msisdn = raw;\n\nconst valid = /^972\\d{9}$/.test(msisdn);\nconst alreadySent = (cols[GUARD_COLUMN_ID] || '').trim() !== '';\n\nreturn [{\n  json: {\n    itemId: item.id,\n    name: item.name,\n    firstName: (item.name || '').trim().split(/\\s+/)[0] || '',\n    email: cols['email_mkwp9hz4'] || '',\n    phoneRaw: cols['phone_mkwpb7vp'] || '',\n    chatId: msisdn + '@c.us',\n    phoneValid: valid,\n    alreadySent,\n    shouldSend: valid && !alreadySent,\n  },\n}];"
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Send Once Only?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [380, 440],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "c2",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true },
              "leftValue": "={{ $json.shouldSend }}",
              "rightValue": ""
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "1 · Welcome Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 360],
      "parameters": {
        "method": "POST",
        "url": "=https://api.green-api.com/waInstance{{ $env.GREENAPI_ID_INSTANCE }}/sendMessage/{{ $env.GREENAPI_API_TOKEN }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chatId: $json.chatId, message: `PLACEHOLDER — הודעת הפתיחה. ${$json.firstName}, ברוך הבא לתוכנית!` }) }}",
        "options": {}
      },
      "notes": "PLACEHOLDER copy — replace with the real welcome message."
    },
    {
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Wait 3s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [820, 360],
      "webhookId": "mxb-onboarding-wait-1",
      "parameters": { "amount": 3, "unit": "seconds" }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "2 · Forms Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 360],
      "parameters": {
        "method": "POST",
        "url": "=https://api.green-api.com/waInstance{{ $env.GREENAPI_ID_INSTANCE }}/sendMessage/{{ $env.GREENAPI_API_TOKEN }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chatId: $('Normalize + Guard').item.json.chatId, message: `PLACEHOLDER — שאלון רפואי: FORM_URL_MEDICAL\\nשאלון פתיחה: FORM_URL_INTAKE` }) }}",
        "options": {}
      },
      "notes": "PLACEHOLDER — replace with the real form links (שאלון רפואי / שאלון פתיחה)."
    },
    {
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "Wait 3s ",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1260, 360],
      "webhookId": "mxb-onboarding-wait-2",
      "parameters": { "amount": 3, "unit": "seconds" }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "3 · Onboarding Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1480, 360],
      "parameters": {
        "method": "POST",
        "url": "=https://api.green-api.com/waInstance{{ $env.GREENAPI_ID_INSTANCE }}/sendMessage/{{ $env.GREENAPI_API_TOKEN }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chatId: $('Normalize + Guard').item.json.chatId, message: `PLACEHOLDER — סרטון האונבורדינג:\\nhttps://drive.google.com/file/d/1uK7Ath3PxeJP1XSqEYw-Cg6APje9EAa2/view?usp=sharing` }) }}",
        "options": {}
      },
      "notes": "Sends the Drive link as its own message, per request. The file is shared 'anyone with the link'."
    },
    {
      "id": "a1000000-0000-4000-8000-000000000013",
      "name": "Mark Sent In Monday",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1700, 360],
      "parameters": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "API-Version", "value": "2024-10" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: 'mutation($item:ID!, $vals:JSON!){ change_multiple_column_values(board_id: 5053409738, item_id: $item, column_values: $vals){ id } }', variables: { item: $('Normalize + Guard').item.json.itemId, vals: JSON.stringify({ ONBOARDING_SENT_COLUMN_ID: { label: 'נשלח' } }) } }) }}",
        "options": {}
      },
      "notes": "Closes the loop so a second webhook for the same client cannot re-send."
    },
    {
      "id": "a1000000-0000-4000-8000-000000000014",
      "name": "Skipped (log)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [600, 560],
      "parameters": {}
    }
  ],
  "connections": {
    "Monday Webhook": { "main": [[{ "node": "Is Handshake?", "type": "main", "index": 0 }]] },
    "Is Handshake?": {
      "main": [
        [{ "node": "Echo Challenge", "type": "main", "index": 0 }],
        [{ "node": "Ack 200", "type": "main", "index": 0 }]
      ]
    },
    "Ack 200": { "main": [[{ "node": "Fetch Client From Monday", "type": "main", "index": 0 }]] },
    "Fetch Client From Monday": { "main": [[{ "node": "Normalize + Guard", "type": "main", "index": 0 }]] },
    "Normalize + Guard": { "main": [[{ "node": "Send Once Only?", "type": "main", "index": 0 }]] },
    "Send Once Only?": {
      "main": [
        [{ "node": "1 · Welcome Message", "type": "main", "index": 0 }],
        [{ "node": "Skipped (log)", "type": "main", "index": 0 }]
      ]
    },
    "1 · Welcome Message": { "main": [[{ "node": "Wait 3s", "type": "main", "index": 0 }]] },
    "Wait 3s": { "main": [[{ "node": "2 · Forms Message", "type": "main", "index": 0 }]] },
    "2 · Forms Message": { "main": [[{ "node": "Wait 3s ", "type": "main", "index": 0 }]] },
    "Wait 3s ": { "main": [[{ "node": "3 · Onboarding Video", "type": "main", "index": 0 }]] },
    "3 · Onboarding Video": { "main": [[{ "node": "Mark Sent In Monday", "type": "main", "index": 0 }]] }
  },
  "pinData": {}
}
