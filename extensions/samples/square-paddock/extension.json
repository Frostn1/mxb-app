{
  "manifestVersion": 1,
  "id": "mxbsecure.square-paddock",
  "name": "Square Paddock",
  "version": "1.0.0",
  "author": "mxbsecure",
  "description": "A square, race-plate look for the whole app: its own logo and wordmark, a square RIDE button with a flag, square cards and fields, block tab markers and a condensed face.",
  "homepage": "https://github.com/Frostn1/mxb-app/blob/main/docs/extensions.md",
  "permissions": [],
  "categories": [
    "themes"
  ],
  "tags": [
    "square",
    "logo",
    "play button",
    "race"
  ],
  "screenshots": [
    "store/1.webp",
    "store/2.webp"
  ],
  "contributes": {
    "themes": [
      {
        "id": "square-paddock",
        "label": "Square Paddock",
        "dark": {
          "window": "#000000",
          "background": "#070707",
          "card": "#121212",
          "popover": "#1a1a1a",
          "secondary": "#1d1d1d",
          "muted": "#121212",
          "foreground": "#f5f5f5",
          "mutedForeground": "#9a9a9a",
          "primary": "#facc15",
          "primaryForeground": "#0a0a0a",
          "accent": "rgba(250, 204, 21, 0.14)",
          "accentForeground": "#fde047",
          "ring": "#facc15",
          "border": "rgba(255, 255, 255, 0.16)",
          "input": "rgba(255, 255, 255, 0.22)"
        },
        "light": {
          "window": "#e7e5e0",
          "background": "#f4f3ef",
          "card": "#ffffff",
          "primary": "#111111",
          "primaryForeground": "#facc15",
          "accent": "rgba(17, 17, 17, 0.08)",
          "accentForeground": "#111111",
          "ring": "#111111",
          "border": "rgba(0, 0, 0, 0.18)"
        },
        "radius": "3px",
        "buttonStyle": "square",
        "fonts": {
          "display": "condensed"
        },
        "brand": {
          "logo": "assets/logo.png",
          "wordmark": "Square Paddock"
        },
        "play": {
          "label": "Ride",
          "icon": "flag",
          "radius": "3px",
          "uppercase": true,
          "width": "wide"
        },
        "components": {
          "cardRadius": "3px",
          "inputRadius": "2px",
          "borderWidth": 1,
          "tabMarker": "block"
        }
      }
    ],
    "buttonStyles": [
      {
        "id": "square",
        "label": "Square",
        "radius": "2px",
        "uppercase": true,
        "letterSpacing": 0.04,
        "weight": 800
      }
    ],
    "fonts": [
      {
        "id": "condensed",
        "family": "Barlow Condensed",
        "src": "fonts/barlowcondensed-600-latin.woff2",
        "weight": "600"
      }
    ]
  }
}
