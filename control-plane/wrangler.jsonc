{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mxb-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],

  // The track prompts live in packages/track-protocol, where the Studio reads them too.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],

  // The public address. workers.dev stays on: shipped apps still call it.
  "routes": [{ "pattern": "api.mxbsecure.com", "custom_domain": true }],
  "workers_dev": true,

  // Provisioning settings. Not secrets — none of these is worth hiding, and having them in
  // config means a change is a reviewable diff rather than an invisible dashboard edit.
  // The credentials (OVH, GitHub dispatch, enroll key) are secrets; see `src/env.d.ts`.
  "vars": {
    // View-only/locked paints are pulled until the memory-only version lands. "on" restores them.
    "VIEW_ONLY_MODE": "off",
    // User server deploy (src/hosting.ts). Money is the limit: a box is ordered only while
    // MXB_HOST_BOX_PRICE_USD x (billed boxes + 1) stays within MXB_HOST_SPEND_CAP_USD. "0" orders
    // nothing at all, which is the safe default until Sean sets a cap. The box count is a second
    // safety limit; Legacy (Wine) is held to one box for its trial.
    "MXB_HOST_SPEND_CAP_USD": "18",
    // One OVH VPS-1 2027 on an OVH US account: $5.35/month plus the $0.50 backup add-on (catalog price), no commitment,
    // 2 vCore / 4 GB / 40 GB NVMe (public catalog). Cap and price are both USD.
    "MXB_HOST_BOX_PRICE_USD": "5.85",
    "MXB_HOST_MAX_BOXES": "4",
    "MXB_HOST_LEGACY_MAX_BOXES": "1",
    "MXB_HOST_SLOTS_NATIVE": "4",
    "MXB_HOST_SLOTS_LEGACY": "2",
    // A hosted server nobody rides on for this long is deleted and its slot freed.
    "MXB_HOST_IDLE_DAYS": "7",
    // A box empty this long is flagged for cancelling at OVH shortly before it renews.
    "MXB_HOST_EMPTY_DAYS": "7",
    // "1" orders a box ahead when a region fills up and saw 2+ deploys in a week, inside the cap.
    "MXB_HOST_PREPROVISION": "0",
    // The public key the box install runner logs in with (its private half is the
    // BOX_SSH_PRIVATE_KEY secret in Frostn1/mxbserver-releases). Empty blocks installs.
    "MXB_HOST_SSH_PUBLIC_KEY": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIATkwdAwpg8xnTVXg2TY5hv+N46TrjZP3wjyi5hJm7J4 mxb-box-install",
    // Paid hosting (src/billing.ts): the Stripe price ids for $5/month mxbserver and $8/month
    // Legacy, made by scripts/stripe-prices.ts. Empty leaves billing off, as do missing
    // STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET secrets: deploy is then invite-only and free.
    "STRIPE_PRICE_MXBSERVER": "price_1UO8nGQtWT6uElJ8RYkyqste",
    "STRIPE_PRICE_LEGACY": "price_1UO8nGQtWT6uElJ8hXkmdpFr",
    // Customer Portal configuration for hosting (bpc_...). Empty uses the account default.
    "STRIPE_PORTAL_CONFIG": "",
    // PiBoSo's own installer, for Legacy boxes. Nothing of theirs is rehosted.
    "MXB_GAME_DOWNLOAD_URL": "https://mx-bikes.com/downloads/mxbikes-beta21e.exe",
    // The account every asset made from mxbsecure.com is created under. Empty disables
    // `/admin/assets`.
    "MXB_OWNER_ACCOUNT_ID": "f72db68a-9541-4814-ae09-6096b497abc9",
    // Where Steam sign-in on mxbsecure.com lands afterwards.
    "MXB_SITE_ORIGIN": "https://mxbsecure.com",
    // Refuses a usage report that carries no valid build signature. Off, and it must stay off
    // until signed builds are the ones in the field — turning it on early drops everybody's
    // numbers and says nothing. The key itself is a secret; see `src/env.d.ts`.
    "MXB_USAGE_REQUIRE_SIGNATURE": "0",
    // The admin and converter Steam accounts are Worker secrets now (ADMIN_STEAM_IDS,
    // CONVERTER_STEAM_IDS; see src/env.d.ts), so this public file carries no Steam IDs.
    // Exact public HTTPS names the admin server manager may call. Empty keeps connection
    // disabled until an operator deliberately adds the reverse-proxied agent host here.
    "MXB_SERVER_AGENT_HOSTS": "16-146-6-22.sslip.io",
    // Require a Valve-confirmed Steam sign-in before any app in the lineup will run. On:
    // MXB App, Studio and Coach show a "Sign in with Steam" wall at startup, every install
    // becomes a proven identity, and a ban has no fresh-account escape. This shuts out anyone
    // without a Steam copy of the game (a Piboso owner has no Steam identity to confirm), so it
    // is a deliberate "Steam players only" decision — flip to "0" to reopen the apps.
    "MXB_REQUIRE_STEAM": "1",
    // Whether mxbsecure.com takes new creators on its own. "closed": the sign-up button is
    // gone and `POST /v1/web/creator` refuses, so the only way to become a creator is the
    // creators page, where one of us adds them — the invite list again, on purpose. A ban
    // follows an install and a Steam login, and while this stood open the way past one was a
    // new Steam account and one click. Anything but "open" is closed; flip it to "open" to
    // take signups again.
    "MXB_CREATOR_SIGNUP": "closed",
    // Where public mod files are served from: the custom domain on the `mxb-assets` bucket.
    "MXB_ASSETS_CDN": "https://cdn.mxbsecure.com",
    // The private bucket's name, for the S3 endpoint the upload URLs are presigned against.
    "MXB_PRIVATE_BUCKET": "mxb-private",
    // What the mirror keeps (`mirrorpolicy.ts`). The download route checks the bike lists before
    // it queues a copy, and the mxb-mirror Worker reads the same names from mirror/wrangler.jsonc,
    // so change both. A name in DENY is never mirrored, a name in ALLOW always may be: comma
    // separated, any spelling ("2021 KTM 450 SX-F OEM" or "MX1OEM_2021_KTM_450_SX-F").
    "MXB_LIVE_TRACK_DAYS": "14",
    "MXB_MIRROR_RETAIN_DAYS": "90",
    "MXB_BIKE_ACTIVE_DAYS": "180",
    "MXB_MIRROR_BIKES_ALLOW": "",
    "MXB_MIRROR_BIKES_DENY": ""
  },

  // Every five minutes: hosted boxes through delivery and install, idle slots, drains, prunes.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // The mod catalogue's slow work belongs to the mxb-mirror Worker (mirror/wrangler.jsonc).
  // This one only queues it: one message per file to fetch or upload to check.
  "queues": {
    "producers": [{ "binding": "MIRROR_QUEUE", "queue": "mxb-mirror" }]
  },

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mxb-control-plane",
      "database_id": "c993c497-28b4-480b-8e6e-fb61a0b18c2b"
    }
  ],

  // One voice room per game server, addressed by the same server key paint sync already
  // computes. Naming the object creates it, and it goes away when the last rider leaves —
  // which is the entire lifecycle. It stores nothing: peers live on their own hibernating
  // sockets, so an idle room costs nothing and there is no state to reconcile.
  "durable_objects": {
    "bindings": [
      { "name": "VOICE_ROOMS", "class_name": "VoiceRoom" },
      // Paint sync's rooms, keyed the same way. Sockets only, like the voice room.
      { "name": "PAINT_ROOMS", "class_name": "PaintRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VoiceRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["PaintRoom"] }
  ],

  // Paints are content-addressed by SHA-256, so an upload of a paint someone else already
  // shared is a no-op and every rider on a server pulls the same object.
  "r2_buckets": [
    {
      "binding": "PAINTS",
      "bucket_name": "mxb-paints"
    },
    // The in-browser locker. Not on the site: mxbsecure.com is static assets, so anything it
    // serves is public, and this is the packer. It is handed out by `/v1/web/lockweb/*` to a
    // signed-in creator and nobody else — see `src/web.ts`.
    {
      "binding": "LOCKWEB",
      "bucket_name": "mxb-lockweb"
    },
    // The FBX -> EDF converter's WebAssembly build. Not on the site for the same reason as the
    // locker: `/v1/web/fbx2edf/*` hands it to granted accounts only (`src/converter.ts`). Its
    // code is private; only the built files are uploaded here, by the private repo's deploy.
    {
      "binding": "FBX2EDF",
      "bucket_name": "mxb-fbx2edf"
    },
    // The mod catalogue's public files, content-addressed under paints/ bikes/ liveries/ kits/
    // tracks/ server/ other/. Served by its custom domain cdn.mxbsecure.com, behind the cache.
    {
      "binding": "ASSET_MIRROR",
      "bucket_name": "mxb-assets"
    },
    // Never public: `.mxbsecure` locked content (signed links only), and uploads in
    // quarantine/ until their checks pass.
    {
      "binding": "ASSET_LOCKED",
      "bucket_name": "mxb-private"
    }
  ],

  // Ceilings in front of the routes that ask Steam or hand out keys. Sign-in is per client
  // address: every return asks Steam, and a login state costs nothing to mint. Key grants are
  // per account: the app asks once per file per PC, so 60 a minute is far past honest use.
  // Track generation is per client address: it is unauthenticated (usable against a local
  // `wrangler dev`) and every call spends our Anthropic budget, so a ceiling keeps a loop from
  // running the bill up. Ten a minute is well past a rider retrying a design.
  "ratelimits": [
    { "name": "SIGNIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "KEY_GRANT_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "TRACK_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    // Paint sync v2: a join per server change plus a heartbeat every five minutes, and one
    // upload per paint the rider wears. 60 a minute is a whole look uploaded at once.
    { "name": "PAINTSYNC_LIMITER", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    // Rating ingest: one push per finished race per managed server, so 30 a minute is far past
    // honest use (a pusher replaying a backlog just gets 429 and retries).
    { "name": "INGEST_LIMITER", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } },
    // Friends: per account, in separate read and write buckets. The app heartbeats presence
    // twice a minute and refreshes the panel on open, so 60 a minute is far past honest use.
    { "name": "FRIENDS_LIMITER", "namespace_id": "1006", "simple": { "limit": 60, "period": 60 } },
    // Series registration: anonymous, per address. Five a minute is a rider fixing a typo; the
    // daily cap in D1 (`series.ts`) is the real ceiling.
    { "name": "REGISTER_LIMITER", "namespace_id": "1007", "simple": { "limit": 5, "period": 60 } },
    // The mod catalogue's public routes, per address: a page of search is one call, a download one
    // more. 120 a minute is a person clicking fast.
    { "name": "ASSETS_LIMITER", "namespace_id": "1008", "simple": { "limit": 120, "period": 60 } },
    // Opening upload sessions, per account. The daily quotas in `uploads.ts` are the real ceiling.
    { "name": "UPLOAD_LIMITER", "namespace_id": "1009", "simple": { "limit": 10, "period": 60 } }
  ]
}
